# ===== 生产环境变量样例（复制为 .env，由 systemd EnvironmentFile 注入；.env 已被 gitignore 忽略）=====
# 本地开发一般不用这个文件，直接靠 local_settings.py 即可。

# ---- Django 基础 ----
# 生产必须设为 0（关闭 DEBUG）；本地开发保持 1/true
DJANGO_DEBUG=0
# 允许访问的主机：逗号分隔，填服务器公网 IP 或已备案域名；不带端口
DJANGO_ALLOWED_HOSTS=127.0.0.1,你的服务器公网IP
# 生产务必换成随机生成的新密钥（不要沿用代码里的开发默认值）
DJANGO_SECRET_KEY=请用python生成一段随机字符串替换

# ---- MySQL 连接 ----
MYSQL_NAME=medical_platform
MYSQL_USER=medical
MYSQL_PASSWORD=你的数据库密码
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ---- 大模型（可选；不填 Key 时 AI 链路自动降级本地规则）----
AI_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
AI_API_KEY=
AI_MODEL=Qwen/Qwen2.5-7B-Instruct
