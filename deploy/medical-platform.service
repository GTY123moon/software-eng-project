# ===== Gunicorn systemd 服务样例 =====
# 部署路径假设：/opt/medical-platform，运行用户 www-data，虚拟环境在 /opt/medical-platform/venv
# 安装步骤：复制为 /etc/systemd/system/medical-platform.service，按实际路径改完后
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now medical-platform
#   sudo systemctl status medical-platform

[Unit]
Description=Medical Platform Django (Gunicorn)
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/medical-platform
EnvironmentFile=/opt/medical-platform/.env
# 虚拟环境里的 gunicorn；若用系统 Python 可去掉 venv 前缀
ExecStart=/opt/medical-platform/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    medical_platform.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
